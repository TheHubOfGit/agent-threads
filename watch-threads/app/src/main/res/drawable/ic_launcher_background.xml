<?xml version="1.0" encoding="utf-8"?>
<!--
  Agent Threads icon, background layer (option B, "Provider ring").
  A dark disc whose rim is the four apps' colors, clockwise from the top: Claude (clay),
  Codex (periwinkle), Antigravity (Gemini gradient), T3 Code (platinum), the same ring language as
  the desk HUD's Pulse layout. The arcs run from radius 28.5 out past the layer's edge, so the rim
  touches the circle's edge whatever size the launcher masks the icon to.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:fillColor="#FF111318" android:pathData="M0,0h108v108h-108z" />
    <!-- Claude: top-right quarter -->
    <path android:strokeColor="#FFD97757" android:strokeWidth="26"
        android:pathData="M54,12.5A41.5,41.5 0,0 1,95.5 54" />
    <!-- Codex: bottom-right quarter -->
    <path android:strokeColor="#FF7A84FF" android:strokeWidth="26"
        android:pathData="M95.5,54A41.5,41.5 0,0 1,54 95.5" />
    <!-- Antigravity: bottom-left quarter, Gemini gradient -->
    <path android:strokeWidth="26" android:pathData="M54,95.5A41.5,41.5 0,0 1,12.5 54">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear"
                android:startX="12" android:startY="54" android:endX="54" android:endY="96">
                <item android:offset="0" android:color="#FF217BFE" />
                <item android:offset="0.5" android:color="#FFAC87EB" />
                <item android:offset="1" android:color="#FFEE4D5D" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- T3 Code: top-left quarter -->
    <path android:strokeColor="#FFD5D8DD" android:strokeWidth="26"
        android:pathData="M12.5,54A41.5,41.5 0,0 1,54 12.5" />
    <!-- Thin dark gaps between the four apps -->
    <path android:strokeColor="#FF111318" android:strokeWidth="2.4"
        android:pathData="M54,0V26M82,54H108M54,82V108M0,54H26" />
</vector>
